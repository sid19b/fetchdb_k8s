pipeline {
    agent {
        kubernetes {
            label "cicd-agent"
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
    - name: podman
      image: quay.io/podman/stable
      command: ['cat']
      tty: true
      securityContext:
        privileged: true
      volumeMounts:
        - name: storage
          mountPath: /var/lib/containers

    - name: tools
      image: dtzar/helm-kubectl:3.16.2
      command: ['cat']
      tty: true
      
  volumes:
  - name: storage
    emptyDir: {}
"""
        }
    }

    environment {
        BACKEND_IMAGE = "siddharth19b/fastapi_backend"
        FRONTEND_IMAGE = "siddharth19b/frontend_k8s"
        NAMESPACE     = "frontend"
    }


    parameters{
        choice(name: 'environment_params', choices: ['sandbox', 'QA', 'prod'], description: 'Pick a choice for deploying in environment. (First value is always the default).')
    }

    stages {

        stage('env validation'){
            steps{
                script{
                    if (params.environment_params != "prod"){
                        echo "deployment cancelled"
                        echo "deployment cant be done in sandbox and QA"
                        currentBuild.result = 'SUCCESS'
                        error("Stopping pipeline — non-prod deployment is not allowed.")
                        return    // gracefully stop whole pipeline
                    }
                    else{
                        echo "Deployment is continuing"
                    }
                }
            }
        }

        /*Approval for prod deployment*/

        stage('Approval for Production Deployment') {
            when { expression { params.environment_params == 'prod' } }
            steps {
                script {
                    timeout(time:5, unit:'MINUTES') {
                        input message: "Are you sure you want to deploy to PROD?", ok: "Deploy"
                    }
                }
            }
        }

        /* ---------------------------
             BUILD BACKEND IMAGE
        ---------------------------- */
        stage('Build Backend Image') {
            steps {
                container('podman') {
                    dir('backend_fastapi') {
                        sh """
                        podman build -t ${BACKEND_IMAGE}:${BUILD_NUMBER} .
                        """
                    }
                }
            }
        }

        /* ---------------------------
             BUILD FRONTEND IMAGE
        ---------------------------- */
        stage('Build Frontend Image') {
            steps {
                container('podman') {
                    dir('frontend_nodejs/frontend') {
                        sh """
                        podman build -t ${FRONTEND_IMAGE}:${BUILD_NUMBER} .
                        """
                    }
                }
            }
        }

        /* ---------------------------
             PUSH IMAGES TO DOCKER HUB
        ---------------------------- */
        stage('Push Images to Docker Hub') {
            steps {
                container('podman') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                      usernameVariable: 'USER',
                                                      passwordVariable: 'PASS')]) {
                        sh """
                        podman login -u $USER -p $PASS docker.io

                        podman push ${BACKEND_IMAGE}:${BUILD_NUMBER}
                        podman tag  ${BACKEND_IMAGE}:${BUILD_NUMBER} ${BACKEND_IMAGE}:latest
                        podman push ${BACKEND_IMAGE}:latest

                        podman push ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                        podman tag  ${FRONTEND_IMAGE}:${BUILD_NUMBER} ${FRONTEND_IMAGE}:latest
                        podman push ${FRONTEND_IMAGE}:latest
                        """
                    }
                }
            }
        }

        /* ---------------------------
             DEPLOY USING HELM
        ---------------------------- */
        stage('Deploy to Kubernetes via Helm backend') {
            when{
               expression{ params.environment_params == "prod"}
            }
            steps {
                container('tools') {
                    dir('backend_fastapi') {
                        sh """
                            helm upgrade --install backend backend-chart \
                                -n ${NAMESPACE} \
                                --set image.repository=${BACKEND_IMAGE} \
                                --set image.tag=${BUILD_NUMBER} \
                                -f values.yaml
                            """
                    }
                }
            }
        }
        stage('Deploy to Kubernetes via Helm frontend') {
            steps {
                container('tools') {
                    dir('frontend_nodejs/frontend') {
                        sh """
                            helm upgrade --install frontend frontend-chart \
                                -n ${NAMESPACE} \
                                --set image.repository=${FRONTEND_IMAGE} \
                                --set image.tag=${BUILD_NUMBER} \
                                -f values.yaml
                            """
                    }
                }
            }
        }
    }
}
