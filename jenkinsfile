pipeline {
    agent {
        kubernetes {
            label "cicd-agent"
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: docker
      image: docker:27.0.3-dind
      securityContext:
        privileged: true
      env:
        - name: DOCKER_TLS_CERTDIR
          value: ""
      command: ['dockerd-entrypoint.sh']
      args: ['--host=tcp://0.0.0.0:2375', '--host=unix:///var/run/docker.sock']
      ports:
        - containerPort: 2375
      tty: true

    - name: tools
      image: dtzar/helm-kubectl:3.16.2
      command: ['cat']
      tty: true
"""
        }
    }

    environment {
        BACKEND_IMAGE = "siddharth19b/fastapi_backend"
        FRONTEND_IMAGE = "siddharth19b/frontend_k8s"
        NAMESPACE = "frontend"
    }

    stages {

        stage('Build Backend Image') {
            steps {
                container('docker') {
                    script {
                        docker.withServer("tcp://localhost:2375") {
                            dir('backend_fastapi') {
                                app_backend = docker.build(
                                    "${BACKEND_IMAGE}:${BUILD_NUMBER}",
                                    "--file Dockerfile ."
                                )
                            }
                        }
                    }
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                container('docker') {
                    script {
                        docker.withServer("tcp://localhost:2375") {
                            dir('frontend_nodejs/frontend') {
                                app_frontend = docker.build(
                                    "${FRONTEND_IMAGE}:${BUILD_NUMBER}",
                                    "--file Dockerfile ."
                                )
                            }
                        }
                    }
                }
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                container('docker') {
                    script {
                        docker.withServer("tcp://localhost:2375") {
                            docker.withRegistry('https://registry.hub.docker.com', 'dockerhub') {

                                app_backend.push("${BUILD_NUMBER}")
                                app_backend.push("latest")

                                app_frontend.push("${BUILD_NUMBER}")
                                app_frontend.push("latest")
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes via Helm') {
            steps {
                container('tools') {
                    sh '''
                        kubectl get ns ${NAMESPACE} || kubectl create ns ${NAMESPACE}

                        cd backend_fastapi/backend-chart
                        helm upgrade --install backend . \
                            -n ${NAMESPACE} \
                            --set image.repository=${BACKEND_IMAGE} \
                            --set image.tag=${BUILD_NUMBER} \
                            -f ../values.yaml

                        cd ../../frontend_nodejs/frontend-chart
                        helm upgrade --install frontend . \
                            -n ${NAMESPACE} \
                            --set image.repository=${FRONTEND_IMAGE} \
                            --set image.tag=${BUILD_NUMBER} \
                            -f ../values.yaml
                    '''
                }
            }
        }
    }
}
