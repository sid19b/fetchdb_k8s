pipeline {
    agent {
        kubernetes {
            label "cicd-agent"
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: build
      image: sdpcloud/helm-kubectl-docker:latest
      command:
        - cat
      tty: true
      volumeMounts:
        - name: dockersock
          mountPath: /var/run/docker.sock
  volumes:
    - name: dockersock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    environment {
        BACKEND_IMAGE = "siddharth19b/fastapi_backend"
        FRONTEND_IMAGE = "siddharth19b/frontend_k8s"
        NAMESPACE = "frontend"
    }

    stages {

        stage('Build Backend Image') {
            steps {
                dir('backend_fastapi') {
                    script {
                        app_backend = docker.build(
                            "${BACKEND_IMAGE}:${BUILD_NUMBER}",
                            "--file backend_fastapi/Dockerfile"
                        )
                    }
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                dir('frontend_nodejs') {
                    script {
                        app_frontend = docker.build(
                            "${FRONTEND_IMAGE}:${BUILD_NUMBER}",
                            "--file frontend_nodejs/frontend/Dockerfile"
                        )
                    }
                }
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub') {
                        // Backend
                        app_backend.push("${BUILD_NUMBER}")
                        app_backend.push("latest")

                        // Frontend
                        app_frontend.push("${BUILD_NUMBER}")
                        app_frontend.push("latest")
                    }
                }
            }
        }

        stage('Deploy to Kubernetes via Helm') {
            steps {
                sh '''
                    # Create namespace if not exists
                    kubectl get ns ${NAMESPACE} || kubectl create ns ${NAMESPACE}

                    cd backend_fastapi
                    helm upgrade --install backend backend-chart \
                        -n ${NAMESPACE} \
                        --set image.repository=${BACKEND_IMAGE} \
                        --set image.tag=${BUILD_NUMBER} \
                        -f values.yaml

                    cd ../frontend_nodejs
                    helm upgrade --install frontend frontend-chart \
                        -n ${NAMESPACE} \
                        --set image.repository=${FRONTEND_IMAGE} \
                        --set image.tag=${BUILD_NUMBER} \
                        -f values.yaml
                '''
            }
        }
    }
}
