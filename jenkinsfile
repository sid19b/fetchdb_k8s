pipeline {
    agent {
        kubernetes {
            label "cicd-agent"
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
    - name: podman
      image: quay.io/podman/stable
      command: ['cat']
      tty: true
      securityContext:
        privileged: true
      volumeMounts:
        - name: storage
          mountPath: /var/lib/containers

    - name: tools
      image: dtzar/helm-kubectl:3.16.2
      command: ['cat']
      tty: true
      
  volumes:
  - name: storage
    emptyDir: {}
"""
        }
    }

    environment {
        BACKEND_IMAGE = "siddharth19b/fastapi_backend"
        FRONTEND_IMAGE = "siddharth19b/frontend_k8s"
        NAMESPACE     = "frontend"
    }

    stages {

        /* ---------------------------
             BUILD BACKEND IMAGE
        ---------------------------- */
        stage('Build Backend Image') {
            steps {
                container('podman') {
                    dir('backend_fastapi') {
                        sh """
                        podman build -t ${BACKEND_IMAGE}:${BUILD_NUMBER} .
                        """
                    }
                }
            }
        }

        /* ---------------------------
             BUILD FRONTEND IMAGE
        ---------------------------- */
        stage('Build Frontend Image') {
            steps {
                container('podman') {
                    dir('frontend_nodejs/frontend') {
                        sh """
                        podman build -t ${FRONTEND_IMAGE}:${BUILD_NUMBER} .
                        """
                    }
                }
            }
        }

        /* ---------------------------
             PUSH IMAGES TO DOCKER HUB
        ---------------------------- */
        stage('Push Images to Docker Hub') {
            steps {
                container('podman') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                      usernameVariable: 'USER',
                                                      passwordVariable: 'PASS')]) {
                        sh """
                        podman login -u $USER -p $PASS docker.io

                        podman push ${BACKEND_IMAGE}:${BUILD_NUMBER}
                        podman tag  ${BACKEND_IMAGE}:${BUILD_NUMBER} ${BACKEND_IMAGE}:latest
                        podman push ${BACKEND_IMAGE}:latest

                        podman push ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                        podman tag  ${FRONTEND_IMAGE}:${BUILD_NUMBER} ${FRONTEND_IMAGE}:latest
                        podman push ${FRONTEND_IMAGE}:latest
                        """
                    }
                }
            }
        }

        /* ---------------------------
             DEPLOY USING HELM
        ---------------------------- */
        stage('Deploy to Kubernetes via Helm') {
            steps {
                container('tools') {
                    sh """
                    kubectl get ns ${NAMESPACE} || kubectl create ns ${NAMESPACE}

                    cd backend_fastapi/backend-chart
                    helm upgrade --install backend . \
                        -n ${NAMESPACE} \
                        --set image.repository=${BACKEND_IMAGE} \
                        --set image.tag=${BUILD_NUMBER}

                    cd ../../frontend_nodejs/frontend-chart
                    helm upgrade --install frontend . \
                        -n ${NAMESPACE} \
                        --set image.repository=${FRONTEND_IMAGE} \
                        --set image.tag=${BUILD_NUMBER}
                    """
                }
            }
        }

    }
}
